---
interface Props {
  labelledby: string;
}

const { labelledby } = Astro.props;
---

<div
  class="rosetta-table"
  tabindex="0"
  role="region"
  aria-labelledby={labelledby}
>
  <slot />
</div>

<style>
  .rosetta-table {
    overflow-x: auto;
    margin-block: 1.5rem;
  }

  .rosetta-table:focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: 2px;
  }

  .rosetta-table :global(table) {
    display: table;
    width: 100%;
    min-width: 54rem;
    table-layout: fixed;
    margin: 0;
  }

  .rosetta-table :global(th),
  .rosetta-table :global(td) {
    overflow-wrap: anywhere;
    vertical-align: top;
  }

  .rosetta-table :global(th:nth-child(1)) {
    width: 28%;
  }
  .rosetta-table :global(th:nth-child(2)) {
    width: 20%;
  }
  .rosetta-table :global(th:nth-child(3)) {
    width: 20%;
  }
  .rosetta-table :global(th:nth-child(4)) {
    width: 32%;
  }
</style>
